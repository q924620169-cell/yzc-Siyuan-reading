{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "allowJs": true
  },
  "include": [
    "plugin/src/**/*.ts",
    "modules/rss/src/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
